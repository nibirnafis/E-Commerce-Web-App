generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}





model Product {
  id        Int     @id @default(autoincrement())
  category  String
  title     String
  details   String
  img_url   String  @default("")
  price     Int
  color     String
  available Boolean @default(true)
  quantity  Int     @default(10)
}